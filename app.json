{
  "expo": {
    "name": "imt-tcc-zyra",
    "slug": "imt-tcc-zyra",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "O ZYRA acessa suas fotos para você escolher uma peça de roupa e cadastrá-la no seu armário."
        }
      ]
    ]
  }
}
